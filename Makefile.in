CC = @CC@
datarootdir = @datarootdir@
prefix = @prefix@
CFLAGS = @CFLAGS@
CORE_SRCS = character.c dice.c diplomacy.c file.c map.c piece.c time.c world.c
CORE_OBJS = ${CORE_SRCS:.c=.o}
CORE_HEADERS = ${CORE_SRCS:.c=.h}
GUI_SRCS = window.c
GUI_OBJS = ${GUI_SRCS:.c=.o}
GUI_HEADERS = ${CORE_SRCS:.c=.o}
OBJS = $(CORE_OBJS) $(GUI_OBJS) feud.o server.o ai.o logic.o single.o editor.o
EXECS = feud feud-editor feud-ai feud-server feud-single
DATAFILES = characters.txt regions.txt

.PHONY: all clean distclean install uninstall

all: $(EXECS)

$(CORE_OBJS) $(GUI_OBJS): %.o: %.c %.h Makefile config.h
	$(CC) -c $(CFLAGS) -DDATADIR=\"$(datarootdir)/feud\" $< -o $@

ai.o editor.o feud.o server.o single.o: %.o: %.c Makefile
	$(CC) -c $(CFLAGS) -DDATADIR=\"$(datarootdir)/feud\" $< -o $@

feud: $(CORE_OBJS) $(GUI_OBJS) feud.o new.o mapgen.o
	$(CC) $(CFLAGS) -o feud $(CORE_OBJS) $(GUI_OBJS) feud.o new.o mapgen.o -lncurses -lm

feud-editor: $(CORE_OBJS) $(GUI_OBJS) editor.o new.o mapgen.o
	$(CC) $(CFLAGS) -o feud-editor $(CORE_OBJS) $(GUI_OBJS) editor.o new.o mapgen.o -lncurses -lm

feud-ai: $(CORE_OBJS) ai.o logic.o
	$(CC) $(CFLAGS) -o feud-ai $(CORE_OBJS) ai.o logic.o -lm

feud-server: $(CORE_OBJS) server.o
	$(CC) $(CFLAGS) -o feud-server $(CORE_OBJS) server.o -lm

feud-single: $(CORE_OBJS) $(GUI_OBJS) logic.o mapgen.o new.o single.o
	$(CC) $(CFLAGS) -o feud-single $(CORE_OBJS) $(GUI_OBJS) logic.o mapgen.o new.o single.o -lncurses -lm

clean:
	for i in $(OBJS) $(EXECS); do \
	if [ -e $$i ]; then rm -v $$i; fi; \
	done

distclean: clean
	rm config.log config.status Makefile

install: uninstall
	if [ ! -d $(DESTDIR)$(prefix)/bin ]; then mkdir -p $(DESTDIR)$(prefix)/bin; fi
	for EXEC in $(EXECS); do \
	install -m 755 $$EXEC $(DESTDIR)$(prefix)/bin/$$EXEC; \
	done
	if [ ! -d $(DESTDIR)$(datarootdir)/feud ]; then mkdir -p $(DESTDIR)$(datarootdir)/feud; fi
	for DATAFILE in $(DATAFILES); do \
	install -m 644 $$DATAFILE $(DESTDIR)$(datarootdir)/feud/$$EXEC; \
	done

uninstall:
	for EXEC in $(EXECS); do \
	if [ -e $(DESTDIR)$(prefix)/bin/$$EXEC ]; then rm $(DESTDIR)$(prefix)/bin/$$EXEC; fi; \
	done
	for DATAFILE in $(DATAFILES); do \
	if [ -e $(DESTDIR)$(datarootdir)/feud/$$DATAFILE ]; then \
	rm $(DESTDIR)$(datarootdir)/feud/$$DATAFILE; fi; \
	done
